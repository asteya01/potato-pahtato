{
  "name": "potato-pahtato",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "set-db-id": "node scripts/set-database-id.mjs",
    "db:local": "wrangler d1 migrations apply potato-pahtato --local",
    "db:remote": "wrangler d1 migrations apply potato-pahtato --remote",
    "dev:api": "wrangler dev --port 8787",
    "test:api": "node tests/api-check.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
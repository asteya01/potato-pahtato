{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "potato-pahtato",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "potato-pahtato",
      "database_id": "a9dbe863-19c8-4654-8c6f-928152cacd83",
      "migrations_dir": "migrations"
    }
  ]
}
